<Window x:Class="CapyServer.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Capy Bara's Server Manager v1.1.0" Icon="app.ico" Width="1380" Height="900" MinWidth="1150" MinHeight="740" Background="#14120F" Foreground="#F5EFDF" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
    <Window.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="#C9BDA7"/><Setter Property="Background" Value="#282319"/><Setter Property="Padding" Value="13,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="#40372A" BorderThickness="1" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,3,0"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#4A3520"/><Setter Property="Foreground" Value="#FFAB49"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#FFAB49"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="DataGrid"><Setter Property="Background" Value="#191610"/><Setter Property="Foreground" Value="#F5EFDF"/><Setter Property="BorderBrush" Value="#40372A"/><Setter Property="RowBackground" Value="#211E18"/><Setter Property="AlternatingRowBackground" Value="#252117"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/></Style></Window.Resources>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#1A1712" BorderBrush="#40372A" BorderThickness="0,0,1,0"><DockPanel Margin="18,23">
            <StackPanel DockPanel.Dock="Top"><Image Source="{StaticResource CapyMascot}" Width="125" Height="105"/><TextBlock Text="Capy Bara's" FontSize="23" FontWeight="Bold" Foreground="#FFAB49" HorizontalAlignment="Center"/><TextBlock Text="SERVER MANAGER" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,28"/>
                <TextBlock Text="YOUR SERVERS" FontSize="10" Foreground="#A49378" Margin="0,0,0,9"/><ComboBox x:Name="ProfilesBox" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" Style="{StaticResource LibraryCombo}"/>
                <Button Content="+ New profile" Click="NewProfile_Click" Margin="0,8,0,7"/><Button Content="Duplicate profile" Click="DuplicateProfile_Click" Margin="0,0,0,7"/><Button Content="Save profile" Click="Save_Click" Style="{StaticResource AccentButton}" Margin="0,0,0,25"/>
                <Button Content="Import server args…" Click="ImportArgs_Click" Margin="0,0,0,7"/><Button Content="Open session files" Click="OpenSession_Click" Margin="0,0,0,7"/><Button Content="Connection guide" Click="Guide_Click" Margin="0,0,0,7"/>
            </StackPanel><StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="Oranges. Friends. Open gates." TextWrapping="Wrap" Foreground="#FFAB49" FontSize="11"/><TextBlock Text="Made for MX Simulator&#10;Built with Codex · v1.1.0" Foreground="#A49378" FontSize="10" Margin="0,7,0,0"/></StackPanel><Border/></DockPanel></Border>
        <Grid Grid.Column="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="22,17" Margin="0,0,0,15"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StartButton" Content="▶  Set up &amp; host" Click="Start_Click" Style="{StaticResource AccentButton}" Margin="0,0,9,0"/><Button x:Name="StopButton" Content="Close session" Click="Stop_Click" IsEnabled="False"/></StackPanel><StackPanel><TextBlock Text="🍊 CAPY BARA'S PADDOCK" Foreground="#FFAB49" FontSize="10" FontWeight="Bold"/><TextBlock Text="Host a session with friends" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,5"/><TextBlock Text="Configure, connect and race — all in one app." Foreground="#B6AA98"/></StackPanel></DockPanel></Border>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,15"><Border Style="{StaticResource Card}" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="SERVER" Foreground="#A49378" FontSize="10"/><TextBlock Text="{Binding StatusText}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="CURRENT TRACK" Foreground="#A49378" FontSize="10"/><TextBlock Text="{Binding LiveTrack}" TextTrimming="CharacterEllipsis" FontSize="15" Margin="0,7,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="15"><StackPanel><TextBlock Text="PLAYERS" Foreground="#A49378" FontSize="10"/><TextBlock Text="{Binding PlayerCount}" FontSize="17" Margin="0,7,0,0"/></StackPanel></Border></UniformGrid>
            <TabControl x:Name="Tabs" Grid.Row="2" Background="#14120F" BorderBrush="#40372A" Padding="14">
                <TabItem Header="Host"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="Session settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/><UniformGrid Columns="4"><StackPanel Margin="0,0,12,12"><TextBlock Text="Profile name"/><TextBox Text="{Binding Profile.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="UDP port"/><TextBox Text="{Binding Profile.Port, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Admin UID"/><TextBox Text="{Binding Profile.AdminUid, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Erode (0–100)"/><TextBox Text="{Binding Profile.Erode, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Default laps"/><TextBox Text="{Binding Profile.Laps, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Default minutes"/><TextBox Text="{Binding Profile.Minutes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Track interval (minutes)"/><TextBox Text="{Binding Profile.TrackInterval, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Bandwidth (bytes/sec)"/><TextBox Text="{Binding Profile.Rate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Maximum clients"/><TextBox Text="{Binding Profile.MaxClients, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Maximum riders"/><TextBox Text="{Binding Profile.MaxPlayers, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Bind address"/><TextBox Text="{Binding Profile.BindAddress, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Status refresh"/><TextBlock Text="Live every second" Foreground="#FFAB49" Margin="0,12,0,0"/></StackPanel></UniformGrid>
                    <TextBlock Text="Greeting"/><TextBox Text="{Binding Profile.Greeting, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>
                    <TextBlock Text="Native server folder"/><DockPanel Margin="0,0,0,10"><Button Content="Choose…" Click="ChooseServer_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding Profile.ServerFolder, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                    <TextBlock Text="Game personal folder (trackinfo exports)"/><DockPanel Margin="0,0,0,10"><Button Content="Choose…" Click="ChooseGame_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding Profile.GameFolder, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                    <TextBlock Text="Game executable (join button)"/><DockPanel Margin="0,0,0,12"><Button Content="Choose…" Click="ChooseExe_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding Profile.GameExecutable, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                    <TextBlock Text="Laps, minutes and interval become defaults for newly added tracks. Each rotation row can override them. Saving changes affects the next server start; use live controls for supported commands." Style="{StaticResource MutedText}"/>
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="Tracks"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12"><TextBlock Text="Track library &amp; race rotation" FontSize="20" FontWeight="SemiBold"/><WrapPanel Margin="0,12,0,0"><Button Content="Scan server + game" Click="Scan_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Import trackinfos…" Click="ImportTrack_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Copy /savetrackinfo" Click="CopyExport_Click" Style="{StaticResource ToolbarButton}"/><CheckBox x:Name="AutoImport" IsChecked="True" Content="Watch game exports" Margin="10,0,0,7"/></WrapPanel><TextBlock Text="Load a track in MX Simulator, type /savetrackinfo in chat, then it appears here. Trackinfos identify tracks; friends still need the matching installed track files." Style="{StaticResource MutedText}"/></StackPanel>
                    <DockPanel Grid.Row="1"><TextBox x:Name="TrackSearch" DockPanel.Dock="Top" TextChanged="TrackSearch_Changed" ToolTip="Search track names" Margin="0,0,0,8"/><ListBox x:Name="TrackLibrary" ItemsSource="{Binding FilteredTracks}" DisplayMemberPath="Name" SelectionMode="Extended" Background="#211E18" Foreground="#F5EFDF" BorderBrush="#40372A" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></DockPanel>
                    <DataGrid x:Name="RotationGrid" Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Profile.Rotation}" SelectionMode="Single"><DataGrid.Columns><DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="40"/><DataGridTextColumn Header="Track" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Laps" Binding="{Binding Laps}" Width="55"/><DataGridTextColumn Header="Min" Binding="{Binding Minutes}" Width="55"/><DataGridTextColumn Header="Interval" Binding="{Binding Interval}" Width="65"/><DataGridTextColumn Header="Next #" Binding="{Binding NextTrack}" Width="65"/></DataGrid.Columns></DataGrid>
                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0"><Button Content="Add selected →" Click="AddTrack_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Move up" Click="MoveUp_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Move down" Click="MoveDown_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Remove" Click="RemoveTrack_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Switch live to selected" Click="SwitchTrack_Click" Style="{StaticResource ToolbarButton}"/><TextBlock Text="Native track numbers are zero-based." Foreground="#A49378" FontSize="11" VerticalAlignment="Center"/></WrapPanel>
                </Grid></TabItem>
                <TabItem Header="Live controls"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,12"><TextBlock Text="Live race &amp; player controls" FontSize="20" FontWeight="SemiBold"/><WrapPanel Margin="0,12,0,0"><Button Content="Restart race" Tag="restart" Click="CommandButton_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Next track" Tag="nexttrack" Click="CommandButton_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Lock server" Tag="lock" Click="CommandButton_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Unlock" Tag="unlock" Click="CommandButton_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Apply current erode" Click="Erode_Click" Style="{StaticResource ToolbarButton}"/></WrapPanel><TextBlock Text="{Binding LiveDetails}" Foreground="#FFAB49"/></StackPanel>
                    <DataGrid x:Name="PlayersGrid" Grid.Row="1" ItemsSource="{Binding Players}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="70"/><DataGridTextColumn Header="UID" Binding="{Binding Uid}" Width="110"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="120"/><DataGridTextColumn Header="Ping ms" Binding="{Binding Ping}" Width="100"/></DataGrid.Columns></DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0"><WrapPanel><Button Content="Kick selected" Click="Kick_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Force play" Tag="forceplay" Click="PlayerCommand_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Force spectate" Tag="forcespec" Click="PlayerCommand_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Mute" Tag="mute" Click="PlayerCommand_Click" Style="{StaticResource ToolbarButton}"/></WrapPanel><DockPanel><Button Content="Send command" Click="SendCommand_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="CommandBox" ToolTip="Native admin command, such as broadcast Hello friends or maxplayers 10"/></DockPanel><TextBlock Text="Native admin command without the server, prefix. No game hooks are used." Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
                </Grid></TabItem>
                <TabItem Header="Connect"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Automatic setup &amp; named game address" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
<Border Background="#211E18" BorderBrush="#40372A" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,0,0,16"><StackPanel>
<TextBlock Text="One-time setup: create a free DuckDNS name, then save its name and account token here. Friends will enter your-name.duckdns.org directly in MX Simulator." Style="{StaticResource MutedText}"/>
<Grid Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="DuckDNS name" FontSize="11"/><TextBox Text="{Binding Profile.DuckDnsDomain, UpdateSourceTrigger=PropertyChanged}" ToolTip="Example: capy-practice or capy-practice.duckdns.org"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Account token (encrypted locally; never included in invites)" FontSize="11"/><PasswordBox x:Name="DuckToken" Background="#191610" Foreground="#F5EFDF" BorderBrush="#4C4030" Padding="12,9"/></StackPanel></Grid>
<WrapPanel><Button Content="Open DuckDNS" Click="OpenDuckDns_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Save name &amp; token" Click="SaveDns_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Set up &amp; host" Click="AutoHost_Click" IsEnabled="{Binding IsEnabled, ElementName=StartButton}" Style="{StaticResource AccentButton}" Padding="12,6" Margin="0,0,8,6"/><CheckBox IsChecked="{Binding Profile.AutomaticSetup}" Content="Use automatic setup" Margin="4,0,0,6"/></WrapPanel>
<TextBlock Text="{Binding DuckCredentialStatus}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,7"/>
<DockPanel><Button Content="Copy game address" Click="CopyGameAddress_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding GameAddress, Mode=OneWay}" IsReadOnly="True" ToolTip="Friends paste this hostname directly into the game. No port number."/></DockPanel>
<TextBlock Text="{Binding SetupStatus}" TextWrapping="Wrap" Foreground="#FFAB49" Margin="0,10,0,0"/>
</StackPanel></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#211E18" BorderBrush="#40372A" BorderThickness="1" CornerRadius="9" Padding="17"><StackPanel>
<TextBlock Text="Join a session" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Paste a capyroom:// invite. The manager carries your game traffic and connects MX Simulator — keep it open while playing." Style="{StaticResource MutedText}" Margin="0,9,0,15"/>
<TextBox x:Name="FriendAddress" ToolTip="capyroom:// invite or direct host:port" Margin="0,0,0,10"/><WrapPanel><Button Content="Join session" Click="JoinFriend_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,8"/><Button Content="Leave session" Click="LeaveRoom_Click" Margin="0,0,0,8"/></WrapPanel>
<TextBlock Text="{Binding RoomStatus}" Foreground="#FFAB49" TextWrapping="Wrap" Margin="0,10,0,18"/><TextBlock Text="Direct host:port addresses work here too. If the game is already open, the app copies its local connection address for the game's Connect screen." Style="{StaticResource MutedText}"/>
</StackPanel></Border>
<Border Grid.Column="2" Background="#211E18" BorderBrush="#40372A" BorderThickness="1" CornerRadius="9" Padding="17"><StackPanel>
<TextBlock Text="Create a session" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Choose tracks and settings on Host / Tracks, then press Set up &amp; host above." Style="{StaticResource MutedText}" Margin="0,9,0,15"/>
<CheckBox IsChecked="{Binding Profile.UseRelay}" Margin="0,0,0,12"><TextBlock Text="Use the integrated Capy room network" TextWrapping="Wrap"/></CheckBox>
<TextBlock Text="Private host pairing (from the in-app room backend)" FontSize="11"/><TextBox Text="{Binding Profile.RelayPairing, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
<CheckBox IsChecked="{Binding Profile.AutoMap}" Margin="0,0,0,15"><TextBlock Text="Request automatic router forwarding for direct hosting" TextWrapping="Wrap"/></CheckBox>
<WrapPanel><Button Content="Allow host firewall…" Click="HostFirewall_Click" Style="{StaticResource ToolbarButton}"/><Button Content="Remove rule…" Click="RemoveHostFirewall_Click" Style="{StaticResource ToolbarButton}"/></WrapPanel><Button Content="Join my local server" Click="JoinLocal_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
</StackPanel></Border></Grid>
<TextBlock Text="Your session invite" FontSize="17" FontWeight="SemiBold" Margin="0,22,0,10"/><DockPanel><Button Content="Copy invite" Click="CopyInvite_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding JoinText, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
<TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" Foreground="#FFAB49" Margin="0,14,0,8"/><TextBlock Text="{Binding LanAddresses}" Style="{StaticResource MutedText}"/>
<TextBlock Text="The room network and its relay run inside this app. A publicly reachable backend machine is still needed for blocked/CGNAT hosts; configure it on Run relay. No hosted relay service is provisioned automatically. Direct hosting needs a reachable public UDP port. Router mappings alone do not verify outside connectivity." Style="{StaticResource MutedText}" Margin="0,18,0,0"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Run relay"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Button Content="Automatic relay setup (name + connection)" Click="AutoRelay_Click" HorizontalAlignment="Left" Style="{StaticResource AccentButton}" Margin="0,0,0,12"/><TextBlock Text="Run the built-in public relay" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Use this tab on a publicly reachable PC or Windows VPS. The private game host pastes your pairing code on its Connect tab. Friends only need the player address. No VPN or separate app is required." Style="{StaticResource MutedText}" Margin="0,8,0,18"/>
                    <UniformGrid Columns="3"><StackPanel Margin="0,0,12,15"><TextBlock Text="Public hostname / IPv4"/><TextBox x:Name="RelayHostName" Text="" ToolTip="The relay machine's public IP or DNS name"/></StackPanel><StackPanel Margin="0,0,12,15"><TextBlock Text="Game UDP port"/><TextBox x:Name="RelayUdp" Text="19801"/></StackPanel><StackPanel Margin="0,0,12,15"><TextBlock Text="Tunnel TCP port"/><TextBox x:Name="RelayTcp" Text="19802"/></StackPanel></UniformGrid><WrapPanel><Button x:Name="RelayStartButton" Content="Start relay" Click="RelayStart_Click" Style="{StaticResource AccentButton}" Margin="0,0,9,9"/><Button Content="Stop relay" Click="RelayStop_Click" Margin="0,0,9,9"/><Button Content="Map relay ports automatically" Click="RelayMap_Click" Margin="0,0,9,9"/><Button Content="Allow relay through firewall…" Click="RelayFirewall_Click" Margin="0,0,9,9"/><Button Content="Remove relay firewall rules…" Click="RemoveRelayFirewall_Click" Margin="0,0,9,9"/></WrapPanel><TextBlock Text="{Binding RelayStatus}" Foreground="#FFAB49" TextWrapping="Wrap" Margin="0,10,0,15"/>
                    <TextBlock Text="Private host pairing code" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Give this only to the person hosting mxserver. It authorizes one host tunnel; it is not a player invite." Style="{StaticResource MutedText}" Margin="0,7,0,9"/><Button Content="Copy private pairing code" Click="CopyPairing_Click" HorizontalAlignment="Left"/>
                    <TextBlock Text="Player join address" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,9"/><DockPanel><Button Content="Copy player room invite" Click="CopyRelayInvite_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding RelayJoinText, Mode=OneWay}" IsReadOnly="True"/></DockPanel><TextBlock Text="The relay and all player/host tunnels are built into this app. Players never launch a separate networking tool. The public relay machine is backend infrastructure." Style="{StaticResource MutedText}" Margin="0,22,0,0"/>
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="Advanced"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,12"><TextBlock Text="Native server options" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Enable an option and enter its value. Repeatable options use one value per line. Relative output files stay inside the managed profile; script paths are relative to the native server folder. Password is admin access, not a join password. Changes apply on the next start." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel><DataGrid x:Name="OptionsGrid" Grid.Row="1" ItemsSource="{Binding Profile.Options}"><DataGrid.Columns><DataGridCheckBoxColumn Header="Use" Binding="{Binding Enabled}" Width="45"/><DataGridTextColumn Header="Option" Binding="{Binding Flag}" IsReadOnly="True" Width="175"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="230"><DataGridTextColumn.EditingElementStyle><Style TargetType="TextBox"><Setter Property="AcceptsReturn" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.EditingElementStyle></DataGridTextColumn><DataGridTextColumn Header="Purpose" Binding="{Binding Description}" IsReadOnly="True" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
                <TabItem Header="Logs"><TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></TabItem>
            </TabControl>
            <TextBlock Grid.Row="3" Text="{Binding Notice}" Foreground="#B6AA98" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
        </Grid>
    </Grid>
</Window>
